# Copy this file to .env and fill in what you actually use.
# Nothing here is required to run Phase 1 with the dummy_sma placeholder —
# yfinance (no key) is enough to see the pipeline work end-to-end.

# --- OANDA v20 practice account (cloud-deployable live feed) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# --- Twelve Data (historical fallback, free tier: 8 req/min, 800/day) ---
TWELVEDATA_API_KEY=

# --- Flask ---
FLASK_SECRET_KEY=dev-secret-change-me
FLASK_DEBUG=true
